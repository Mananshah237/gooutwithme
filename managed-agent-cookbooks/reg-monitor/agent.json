{
  "name": "reg-monitor",
  "version": "1.0.0",
  "description": "Weekly sweep of regulatory feeds for new rules, amendments, and enforcement actions in configured practice areas.",
  "schedule": "weekly",
  "model": "claude-opus-4-8",
  "tools": {
    "orchestrator": ["read_file", "web_search"],
    "subagent": ["read_file", "write_file", "web_search", "web_fetch", "mcp_slack"]
  },
  "env_required": ["ANTHROPIC_API_KEY"],
  "env_optional": ["SLACK_BOT_TOKEN", "SLACK_CHANNEL_ID"]
}
