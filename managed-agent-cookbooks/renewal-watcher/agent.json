{
  "name": "renewal-watcher",
  "version": "1.0.0",
  "description": "Weekly scan of contract register for cancel-by deadlines within 90 days. Posts digest to Slack.",
  "schedule": "weekly",
  "model": "claude-opus-4-8",
  "tools": {
    "orchestrator": ["read_file"],
    "subagent": ["read_file", "write_file", "mcp_ironclad", "mcp_slack"]
  },
  "env_required": ["ANTHROPIC_API_KEY"],
  "env_optional": ["IRONCLAD_API_KEY", "IRONCLAD_WORKSPACE_ID", "SLACK_BOT_TOKEN", "SLACK_CHANNEL_ID"]
}
